FROM node:20-alpine AS builder

WORKDIR /app
COPY apps/workforce-console/package*.json ./
RUN npm ci
COPY apps/workforce-console/ ./
COPY packages/sdk/ ./experience-sdk/
RUN mkdir -p node_modules/@olympion && ln -s /app/experience-sdk node_modules/@olympion/experience-sdk
RUN npm run build

FROM nginx:1.27-alpine

COPY docker/nginx-workforce-console.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/out /usr/share/nginx/html

EXPOSE 80
